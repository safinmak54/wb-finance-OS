  "sales_summary": {
    "_source": "Admin API: /sales-summary/live?segment=all&startDate=YYYY-MM-DD&endDate=YYYY-MM-DD&groupBy=month — called once with no companyIds (aggregate) plus once per company_id (per-entity).",
    "_storedAs": "cashbook_snapshots.payload where source='sales_summary'. Wrapper shape: { aggregate, byCompany: { [companyId]: SalesSummaryReport } }. Legacy snapshots may still contain a raw SalesSummaryReport; read paths handle both.",
    "_consumedBy": "SalesSummaryPanel in app/(app)/cashbook/CashbookClient.tsx (aggregate for ALL tab, byCompany[id] for entity tabs).",
    "_note": "Schema is .passthrough(): any extra fields the API returns are preserved in the JSONB column even though the UI doesn't render them yet. Per-entity calls null-out channel-split fields (net_sales_asi, etc.) — this is expected per Admin API guide §3.5.",
    "_storedExample": {
      "aggregate": "{ ... SalesSummaryReport for all companies ... }",
      "byCompany": {
        "1": "{ ... SalesSummaryReport with companyIds=1 (channel-split nulled) ... }",
        "5": "{ ... SalesSummaryReport with companyIds=5 ... }"
      }
    },
    "example": {
      "rows": [
        {
          "period": "2026-05",
          "gross_sales": 109110.35,
          "net_sales": 106800.35,
          "orders_count": 1842,
          "cogs": 41280.00,
          "cogs_invoiced": 38420.00,
          "cogs_estimated": 2860.00,
          "cogs_pct": 38.65,
          "ads_cost_total": 18420.55,
          "ads_cost_google": 9820.10,
          "ads_cost_bing": 1240.00,
          "ads_cost_meta": 6210.45,
          "ads_cost_asi": 1150.00,
          "ads_pct": 17.25,
          "roas": 5.79,
          "avg_order_value": 57.97,
