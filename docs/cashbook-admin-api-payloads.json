          "orders_returned": 3,
          "gross_margin_pct": 61.35,
          "target_net_sales": 110000.00
        }
      ],
      "totals": {
        "period": "2026-05",
        "gross_sales": 109110.35,
        "net_sales": 106800.35,
        "orders_count": 1842,
        "cogs": 41280.00,
        "cogs_invoiced": 38420.00,
        "cogs_estimated": 2860.00,
        "cogs_pct": 38.65,
