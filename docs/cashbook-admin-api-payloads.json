    "_fieldNotes": {
      "period": "Bucket label; format depends on group_by (YYYY-MM for month, YYYY-MM-DD for day, etc.).",
      "cogs": "Invoiced + estimated. Estimated covers orders shipped but not yet billed by vendor.",
      "ads_cost_total": "Sum of google + bing + meta + asi. Verify on import — channels can be added by the API.",
      "roas": "ads / net_sales ratio. Nullable when ads_cost_total = 0.",
      "avg_order_value": "Nullable when orders_count = 0.",
      "target_net_sales": "Manually set target for the period (nullable)."
    }
  },

  "_supabaseRow": {
    "_table": "cashbook_snapshots",
    "_oneRowPerPeriodAndSource": "(period_start, period_end, source) — re-fetch overwrites via insert + most-recent-wins read.",
    "example": {
      "id": "a1f3...uuid",
      "period_start": "2026-05-01",
      "period_end": "2026-05-31",
      "source": "payment_method",
      "payload": "{ ... PaymentMethodReport JSON above ... }",
